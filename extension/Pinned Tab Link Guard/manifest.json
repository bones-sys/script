{
  "manifest_version": 3,
  "name": "Pinned Tab Link Guard",
  "version": "1.1.0",
  "description": "ピン留めタブ内のリンクを新しいタブで開き、ピン留めタブのURLを保持します。",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
